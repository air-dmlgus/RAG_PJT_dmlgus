# 복사하여 .env로 저장. 키를 코드에 넣지 마세요.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# GMS 사용 시 BASE_URL과 실제 사용 가능한 모델 이름을 담당 교육 안내에 맞춰 변경.
# 실사용은 online. demo는 키 없이 구조를 검증하는 로컬 해시 벡터/발췌 모드.
KBO_MODE=demo
WIKI_USER_AGENT=KBOInside-Educational/1.0 (set-your-contact-before-online-use)
